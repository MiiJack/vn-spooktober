Narrator: Shateroo, Lake
[background arg="res://assets/backgrounds/lake_side_placeholder.jpg" fade="1.0" transition="Push Left" wait="true"]
audio BGS "res://assets/audio/sfx/Lake - sound.wav" [loop="true"]
